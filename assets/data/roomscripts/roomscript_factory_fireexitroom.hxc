function CTSCRIPT_SETNAME():String
{
	return "factory_fireexitroom";
}

var character_robin:Player;
var character_managerscary:Character;

var thetopdoor:Door;
var thebottomdoor:Door;

var gridStart:Int = 30;
var gridEnd:Int = 40;

var colorA:Array<Int> = [0, 0, 0, 255];
var colorB:Array<Int> = [0, 19, 100, 255];

var colorGlow:Array<Int> = [0, 0, 0, 0];

var lastPlayerY:Float = 0;

var lightingShader:LightingEffectShader;

var managerHurt:Bool = false;
var managerHurtTimer:Float = 0;
var managerHurtTimerMax:Float = .75;

var spr_behindProps:FlxSpriteGroup;
var props:FlxTypedSpriteGroup<FlxSprite>;

var fullart_bg:CtSprite;
var fullart_robin:CtSprite;
var fullart_manager:CtSprite;
var fullart_fade:CtSprite;

var monstermanagerdead:Prop;
var monstermanagerdeadblood:Prop;

var seenEndScene:Bool = false;

var monsterdialogue:Interactable;

function create(){
    character_robin = get_player();
    character_managerscary = getCharacterByTag("managerscary");
    character_managerscary.kill();

    thetopdoor = getDoorByTag("thetopdoor");
    thebottomdoor = getDoorByTag("thebottomdoor");

    lightingShader = get_lightingShader();
    
    spr_behindProps = get_spr_behindProps();
    props = get_props();

    monstermanagerdead = getPropByTag("monstermanagerdead");
    monstermanagerdead.kill();

    monstermanagerdeadblood = getPropByTag("monstermanagerdeadblood");
    monstermanagerdeadblood.kill();

    monsterdialogue = getInteractableByTag("monsterdialogue");
    monsterdialogue.disabled = true;

    setColor();
    updatePlayerPos();

    if(InitState.init_forceCutscene == "postManagerBossScene"){
        prepPostManagerBossScene();
        new FlxTimer().start(2, function(f):Void{
            doPostManagerBossScene();
        });
    }
}

function update(elapsed:Float){
    if(character_robin.y != lastPlayerY){
        setColor();
    }
    updatePlayerPos();

    if(managerHurt){
        managerHurtTimer += elapsed;
        if(managerHurtTimer >= managerHurtTimerMax){
            managerHurtTimer -= (managerHurtTimerMax * FlxG.random.float(.6, 1.6));

            CtSound.play(Constants.sfx_bat_damage, .3).pitch = FlxG.random.float(.6, 1);
            FlxTween.shake(character_managerscary, 0.05, .2, 0x01);
        }
    }
}

function getYCordByGrid(pos:Float):Float{
    return ((pos * 16) * Constants.overworldPixelScale);
}

function updatePlayerPos():Void{
    lastPlayerY = character_robin.y;
}

function setColor():Void{
    var factor = FlxMath.bound((character_robin.y - getYCordByGrid(gridStart)) / (getYCordByGrid(gridEnd) - getYCordByGrid(gridStart)), 0, 1);
                
    var newcolor:Array<Int> = [];
            
    newcolor[0] = Std.int((colorB[0] - colorA[0]) * factor + colorA[0]);
    newcolor[1] = Std.int((colorB[1] - colorA[1]) * factor + colorA[1]);
    newcolor[2] = Std.int((colorB[2] - colorA[2]) * factor + colorA[2]);
    newcolor[3] = Std.int((colorB[3] - colorA[3]) * factor + colorA[3]);
            
    lightingShader.updateColorsFromArray(newcolor, colorGlow);
}

function doBossIntroScene():Void{
    if(Save.storyFlags.get("factory_seenManagerBossIntro").val_bool || seenEndScene){
        return;
    }

    set_inCutscene(true);

    Save.storyFlags.get("factory_seenManagerBossIntro").val_bool = true;

    // Robin stops, manager bangs on door
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("bang bang");

        var muted:Bool = false;

        for(i in 0...3){
            new FlxTimer().start(.65 * i, function(f):Void{
                if(!muted){
                    muted = true;
                    FlxG.sound.music.stop();
                    FlxG.sound.music.destroy();
                    FlxG.sound.music = null;
                }
                bangOnDoor(.4);

                if(i == 2){
                    new FlxTimer().start(1.5, function(f):Void{
                        OverworldState.eventManager.finishTransaction("bang bang");
                    });
                }
            });
        }
    });

    // "Is he still here?""
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("talk");

        startDialogue(["factory/fireexitroom/dialogue_boss_0"], function():Void
		{
			OverworldState.eventManager.finishTransaction("talk");
		});
    });

    // Zoom camera down to manager
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("zoom");

        character_managerscary.revive();
        character_managerscary.positionCharacterByGrid(15.5, 41);

        set_lockCamera(true);

        FlxTween.tween(camGame.scroll, {y: 1530}, 3, {ease: FlxEase.quartInOut, onComplete: function(f):Void{
            OverworldState.eventManager.finishTransaction("zoom");
        }});

        CtSound.play(Constants.sfxPath + "managerambience.ogg");
    });

    // shake door again
	OverworldState.eventManager.addEvent(function()
	{
        OverworldState.eventManager.startTransaction("bang bang");

        for(i in 0...3){
            new FlxTimer().start(.9 * i, function(f):Void{
                bangOnDoor();

                if(i == 2){
                    new FlxTimer().start(2, function(f):Void{
                        OverworldState.eventManager.finishTransaction("bang bang");
                    });
                }
            });
        }
    });

    // manager trn around
	OverworldState.eventManager.addEvent(function()
	{
        OverworldState.eventManager.startTransaction("turn");
        
        FlxTween.shake(character_managerscary, 0.05, .2, 0x01);
        character_managerscary.facing = RIGHT;
        CtSound.play(Constants.sfxPath + "checkjess.ogg", .5);

        new FlxTimer().start(1, function(f):Void{
            FlxTween.shake(character_managerscary, 0.05, .2, 0x01);
            character_managerscary.facing = UP;
            CtSound.play(Constants.sfxPath + "checkjess.ogg", .5).pitch = .7;

            new FlxTimer().start(2, function(f):Void{
                OverworldState.eventManager.finishTransaction("turn");
            });
        });

        OverworldState.setUpMusic(Constants.roomMusicPath + "chase.ogg", 4);
        FlxG.sound.music.pitch = 0;
        FlxTween.tween(FlxG.sound.music, {pitch: .5}, 3);
    });

    // manager stands up
	OverworldState.eventManager.addEvent(function()
	{
        OverworldState.eventManager.startTransaction("stand");
        
        FlxTween.shake(character_managerscary, 0.08, .2, 0x01);
        character_managerscary.changeAnimationPrefix("stand-");
        CtSound.play(Constants.sfxPath + "managergetup.ogg", .5);

        new FlxTimer().start(2, function(f):Void{
            OverworldState.eventManager.finishTransaction("stand");
        });
    });

    /**
     * the manager runs at robin, camera pans up
     */
    OverworldState.eventManager.addEvent(function(){
        OverworldState.eventManager.startTransaction("RUN");
        OverworldState.eventManager.startTransaction("camera go back");
        OverworldState.eventManager.startTransaction("robin backup");

        character_managerscary.lockAnims = true;
        character_managerscary.animation.play("walkbutslow");
        character_managerscary.movementSpeed = .23;
        
        character_managerscary.moveToGridSpace(-1, 18, function():Void
		{
			character_managerscary.lockAnims = false;
            OverworldState.eventManager.finishTransaction("RUN");
		});

        character_managerscary.animation.onFrameChange.add(function(name:String, frameNum:Int, frameIndex:Int):Void
		{
			if (name == "walkbutslow")
			{
				if (frameNum == 1)
				{
					CtSound.play(Constants.sfxPath + "managerstep" + FlxG.random.int(1,3) + ".ogg", 0.7).pitch = .5;

				    FlxTween.shake(character_managerscary, 0.05, .2, 0x01);
				}
			}
		});

        // put robin in place
        character_robin.positionCharacterByGrid(16, 22);

        moveCameraBackToPlayer(5, FlxEase.quartInOut, function():Void{
			character_managerscary.hitbox.y -= 180; // go faster pls
            character_managerscary.movementSpeed = .6;
            OverworldState.eventManager.finishTransaction("camera go back");
		});		

        new FlxTimer().start(3, function(f):Void{
            character_robin.lockMovement = true;
            character_robin.lockAnims = true;

            character_robin.animation.play("walk_down");
            character_robin.movementSpeed = .2;

            character_robin.moveToGridSpace(-1, 16, function():Void
            {
                character_robin.lockAnims = false;
                character_robin.facing = DOWN;
                OverworldState.eventManager.finishTransaction("robin backup");
            });
        });
    });

    // "Gjh.... YOU...""
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        startDialogue(["factory/fireexitroom/dialogue_boss_1"], function():Void
        {
            OverworldState.eventManager.finishTransaction("talk");
        });
    });

    // Volor flashes and knocks manager back.. 
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        camUI.flash(0xFF0026FF);
        character_managerscary.changeAnimationPrefix("");

        FlxTween.tween(FlxG.sound.music, {pitch: 1.3}, 2);

        CtSound.play(Constants.sfxPath + "managerslide.ogg");
        CtSound.play(Constants.sfxPath + "jacketshatter.ogg");

        FlxTween.tween(character_managerscary.hitbox, {y: character_managerscary.hitbox.y + 200}, 1.5, {ease: FlxEase.quartOut, onComplete: function(f):Void{
            managerHurt = true;
            new FlxTimer().start(1.5, function(f):Void{
                OverworldState.eventManager.finishTransaction("talk");
            });
        }});
    });

    // "He's actually hurt??"
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        startDialogue(["factory/fireexitroom/dialogue_boss_2"], function():Void
        {
            OverworldState.eventManager.finishTransaction("talk");
        });
    });

    // walk down and start battle
    OverworldState.eventManager.addEvent(function()
    {
        FlxTween.tween(FlxG.sound.music, {volume: 0}, 3);

        character_robin.movementSpeed = .2;
        character_robin.moveToGridSpace(-1, 20, function():Void
        {
            managerHurt = false;

            startBattle("factory_managerboss");
        });
    });
}

function bangOnDoor(?vol:Float = 1):Void{
    camGame.shake(0.023, .2, null, true, 0x01);
    FlxTween.shake(thebottomdoor, 0.13, .35, 0x01);
    
    CtSound.play(Constants.sfxPath + "hitdoor.ogg", vol).pitch = FlxG.random.float(.5, 1);
}

function battleTransitionDone(name:String):Void{
    if(name == "factory_managerboss"){
        doPostManagerBossScene();
    }
}

function backFromBattle(name:String):Void{
    if(name == "factory_managerboss"){
        prepPostManagerBossScene();
    }
}

function prepPostManagerBossScene():Void{
    Save.storyFlags.get("factory_killedmanager").val_bool = true;

    seenEndScene = true;

    character_robin.positionCharacterByGrid(16, 15);

    character_managerscary.revive();
    character_managerscary.positionCharacterByGrid(15.5, 19);
    character_managerscary.facing = UP;

    thetopdoor.room = "";
    thetopdoor.dialogue = "factory/fireexitroom/dialogue_no";

    set_lockCamera(true);
    camGame.scroll.y = 650;

    new FlxTimer().start(0.01, function(f):Void{
		FlxG.sound.music.stop();
	});

    setUpFullArt();
}

function doPostManagerBossScene():Void{
    set_inCutscene(true);
    set_lockCamera(true); // again

    character_managerscary.hitbox.solid = false;

    // off blodo splatter lol
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("blood");

        var bloodSplatter = new CtSprite().createFromImage(Constants.overworldMiscGraphicPath + "managerbloodsplatter.png");
        bloodSplatter.antialiasing = false;
        bloodSplatter.scale.set(Constants.overworldPixelScale, Constants.overworldPixelScale);
	    bloodSplatter.updateHitbox();
        spr_behindProps.add(bloodSplatter);

        bloodSplatter.setPosition(character_managerscary.x, character_managerscary.y);
        bloodSplatter.x += Std.int(30 * Constants.overworldPixelScale);

        CtSound.play(Constants.sfxPath + "stab.ogg").pitch = FlxG.random.float(0.8, 1.2);
        FlxTween.shake(character_managerscary, 0.02, .2, 0x01);

        FlxTween.tween(bloodSplatter, {alpha: 0}, .4, {onComplete: function(f):Void{
            bloodSplatter.flipX = true;
            bloodSplatter.x -= Std.int(40 * Constants.overworldPixelScale);

            CtSound.play(Constants.sfxPath + "stab.ogg").pitch = FlxG.random.float(0.8, 1.2);
            FlxTween.shake(character_managerscary, 0.04, .2, 0x01);

            bloodSplatter.alpha = 1;
            FlxTween.tween(bloodSplatter, {alpha: 0}, .4, {onComplete: function(f):Void{
                bloodSplatter.destroy();

                new FlxTimer().start(.5, function(F):Void{
                    OverworldState.eventManager.finishTransaction("blood");
                });
            }});
        }});
    });

    // flash to white and make him dead
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("flash");
        camUI.flash(0xFF75D0DE);
        CtSound.play(Constants.sfxPath + "stabbig.ogg").pitch = 0.9;

        FlxG.sound.music.play();
        var preVol = FlxG.sound.music.volume * 1.3;
        FlxG.sound.music.volume = 0;
        FlxTween.tween(FlxG.sound.music, {volume: preVol}, 2);
        FlxG.sound.music.pitch = .5;

        monstermanagerdead.setPosition(character_managerscary.x, character_managerscary.y);
        monstermanagerdead.revive();

        monstermanagerdeadblood.setPosition(character_managerscary.x, character_managerscary.y);
        monstermanagerdeadblood.revive();

        character_managerscary.kill();

        new FlxTimer().start(3, function(f):Void{
            OverworldState.eventManager.finishTransaction("flash");
        });
    });

    // "hah  hah"
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        startDialogue(["factory/fireexitroom/dialogue_postboss_1"], function():Void
        {
            OverworldState.eventManager.finishTransaction("talk");
        });
    });

    // robin walks down to manager
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("walkdown");

        character_robin.lockMovement = true;
		character_robin.movementSpeed = .3;
		character_robin.moveToGridSpace(-1, 17, function():Void
		{
			OverworldState.eventManager.finishTransaction("walkdown");
		});
	});

	// robin checks manager
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("checkpulse");

		character_robin.lockAnims = true;
		character_robin.animation.play("crouch_front");

		new FlxTimer().start(.5, function(f):Void{
			FlxTween.shake(monstermanagerdead, 0.02, .2, 0x01);
			CtSound.play(Constants.sfxPath + "checkjess.ogg");

            new FlxTimer().start(2, function(f):Void{
                OverworldState.eventManager.finishTransaction("checkpulse");
            });
		});
	});

    // "i think hes dead"
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        character_robin.lockAnims = false;

        startDialogue(["factory/fireexitroom/dialogue_postboss_2"], function():Void
        {
            OverworldState.eventManager.finishTransaction("talk");
        });
    });

    // show full art
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("full art");

		fullart_fade.visible = true;
		fullart_fade.alpha = 0;
        camOverlay.scroll.y = -300;
		FlxTween.tween(fullart_fade, {alpha: 1}, 2, {onComplete: function(f):Void{
			fullart_bg.visible = true;
            fullart_robin.visible = true;
			fullart_manager.visible = true;

			FlxTween.tween(fullart_fade, {alpha: 0}, 2);

            FlxTween.tween(camOverlay.scroll, {y: 0}, 4, {onComplete: function(f):Void{

                new FlxTimer().start(2, function(f):Void{
                    OverworldState.eventManager.finishTransaction("full art");
                });
            }});
		}});
	});

     // hide full art
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("full art");

		FlxTween.tween(fullart_fade, {alpha: 1}, 2, {onComplete: function(f):Void{
			fullart_bg.visible = false;
            fullart_robin.visible = false;
			fullart_manager.visible = false;

            FlxTween.tween(fullart_fade, {alpha: 0}, 2, {onComplete: function(f):Void{
                OverworldState.eventManager.finishTransaction("full art");
            }});
		}});
	});

    // "lets leave"
    OverworldState.eventManager.addEvent(function()
    {
        OverworldState.eventManager.startTransaction("talk");

        character_robin.lockAnims = false;

        startDialogue(["factory/fireexitroom/dialogue_postboss_3"], function():Void
        {
            OverworldState.eventManager.finishTransaction("talk");
        });
    });

    // Camera goes back to robin
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("camra");

		moveCameraBackToPlayer(2, null, function():Void{
			OverworldState.eventManager.finishTransaction("camra");
		});
	});

	// End cutscene
	OverworldState.eventManager.addEvent(function()
	{
        monsterdialogue.disabled = false;
        character_robin.movementSpeed = 1;
		set_lockCamera(false);
		set_inCutscene(false);
		character_robin.facing = DOWN;
		character_robin.lockMovement = false;
	});
}

function setUpFullArt():Void
{
	fullart_bg = new CtSprite().createFromImage(Constants.overworldCutsceneGraphicPath + "managercorpse_bgColor.png");
	fullart_bg.screenCenter();
	fullart_bg.camera = camOverlay;
	fullart_bg.visible = false;
    fullart_bg.scrollFactor.set(0,0);
	add(fullart_bg);

	fullart_robin = new CtSprite().createFromImage(Constants.overworldCutsceneGraphicPath + "managercorpse_robin.png");
	fullart_robin.screenCenter();
	fullart_robin.camera = camOverlay;
	fullart_robin.visible = false;
	fullart_robin.antialiasing = false;
    fullart_robin.scrollFactor.set(.7,.7);
	add(fullart_robin);

    fullart_manager = new CtSprite().createFromImage(Constants.overworldCutsceneGraphicPath + "managercorpse_manager.png");
	fullart_manager.screenCenter();
	fullart_manager.camera = camOverlay;
	fullart_manager.visible = false;
	fullart_manager.antialiasing = false;
	add(fullart_manager);

	fullart_fade = new CtSprite().createColorBlock(FlxG.width, FlxG.height, 0xFF000000);
	fullart_fade.camera = camOverlay;
	fullart_fade.visible = false;
    fullart_fade.scrollFactor.set(0,0);
	add(fullart_fade);
}