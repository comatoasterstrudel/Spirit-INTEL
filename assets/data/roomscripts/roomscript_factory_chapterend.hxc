var spr_fg:CtSprite;

var spr_cg:CtSprite;
var spr_fade:CtSprite;

//stolen from chapterintro
var bottom:CtSprite;

var leaving:Bool = false;

var newMusic:FlxSound;

function create():Void{
	set_inCutscene(true);
	camGame.visible = false;
	OverworldState.lastTransitionTime = 3;

	spr_fg = new CtSprite().createFromImage(Constants.chapterEndGraphicPath + "prologue_fg.png");
	spr_fg.antialiasing = false;
	spr_fg.camera = camOverlay;
	spr_fg.screenCenter();
	add(spr_fg);

	//cg
	spr_cg = new CtSprite().createFromImage(Constants.chapterEndGraphicPath + "prologue_endcg.png");
	spr_cg.antialiasing = false;
	spr_cg.camera = camOverlay;
	spr_cg.screenCenter();
	spr_cg.visible = false;
	spr_cg.scrollFactor.set(0,0);
	add(spr_cg);

	spr_fade = new CtSprite().createColorBlock(FlxG.width, FlxG.height, 0xFF000000);
	spr_fade.camera = camOverlay;
	spr_fade.visible = false;
	spr_fade.scrollFactor.set(0,0);
	add(spr_fade);

	// text
	bottom = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "bottom.png");
	bottom.screenCenter();
	bottom.y = FlxG.height - bottom.height;
	bottom.antialiasing = false;
	bottom.camera = camUI;
	bottom.alpha = 0;
	add(bottom);

	// music for cg
	newMusic = CtSound.loadEmbedded(Constants.roomMusicPath + "spirittrainmuffled.ogg", true);
	FlxG.sound.list.add(newMusic);

	doScroll();

	doScene();
}
 
function doScroll():Void
{
	var scrollamount:Float = 12;

	camOverlay.scroll.x = -scrollamount;

	FlxTween.tween(camOverlay.scroll, {x: scrollamount}, 5, {
		type: 4,
		ease: FlxEase.quadInOut
	});
}

function doScene():Void{

	// first dialogue
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("talk");

		new FlxTimer().start(3, function(f):Void{
			startDialogue(["factory/chapterend/dialogue_end"], function():Void
			{
				new FlxTimer().start(2, function(f):Void{
					OverworldState.eventManager.finishTransaction("talk");
				});
			});
		});
	});

	// show cg
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("cg");

		spr_fade.visible = true;
		spr_fade.alpha = 0;

		FlxTween.tween(spr_fade, {alpha: 1}, 2, {onComplete: function(f):Void{
			spr_cg.visible = true;
			FlxTween.tween(spr_fade, {alpha: 0}, 2, {onComplete: function(f):Void{
				OverworldState.eventManager.finishTransaction("cg");
			}});
		}});

		newMusic.play();
		newMusic.volume = 0;
		newMusic.time = FlxG.sound.music.time;

		var vol = FlxG.sound.music.volume;

		FlxTween.tween(newMusic, {volume: vol}, 4);
		FlxTween.tween(FlxG.sound.music, {volume: 0}, 4);
	});

	// ending
	OverworldState.eventManager.addEvent(function()
	{
		OverworldState.eventManager.startTransaction("end");

		new FlxTimer().start(4, function(f):Void{
			FlxTween.tween(bottom, {alpha: 1}, 1.5, {onComplete: function(f):Void{
				new FlxTimer().start(2, function(f):Void{
					var bigText = new CtText();
					bigText.text = 'PROLOGUE END';
					bigText.setFormat(Constants.fontName, 60, 0xFFFFFFFF);
					bigText.camera = camUI;
					bigText.screenCenter();
					bigText.y = FlxG.height - 100;
					add(bigText);

					doLetterTransition(bigText, 3.5, function():Void{
						FlxTween.tween(newMusic, {volume: 0}, 7.5);

						var black = new CtSprite().createColorBlock(FlxG.width, FlxG.height, 0xFF000000);
						black.camera = camUI;
						black.alpha = 0;
						add(black);

						FlxTween.tween(black, {alpha: 1}, 5, {startDelay: 3});
						
						new FlxTimer().start(13, function(f):Void{
							OverworldState.eventManager.finishTransaction("end");
						});
					});
				});			
			}});
		});
	});

	// ending (real)
	OverworldState.eventManager.addEvent(function()
	{
		var isDemo:Bool = GameStatus.isPrologueDemo();

		if(isDemo){
			moveRoom("factory_demoend", .1);
		}
	});
}

function doLetterTransition(text:FlxSprite, time:Float, onComplete:Void->Void):Void{
	text.y -= 30;
	text.alpha = 0;
	FlxTween.tween(text, {alpha: 1, y: text.y + 30}, time, {ease: FlxEase.quartOut, onComplete:function(f):Void{
		onComplete();
	}});
}