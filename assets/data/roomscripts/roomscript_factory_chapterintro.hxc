function CTSCRIPT_SETNAME():String
{
	return "factory_chapterintro";
}

// bg shit
var bg_back:CtSprite;

// ui shit
var conductor:CtConductor;

var startingBeat:Int = 16;
var endingBeat:Int = 24;

var text:Array<String> = ["P", "R", "O", "L", "O", "G", "U", "E"];
var chapterName = "Tommorow is my birthday";

var bottom:CtSprite;

var letters:FlxSpriteGroup;
var letterList:Array<CtText> = [];

var black:CtSprite;

var ending:Bool = false;

var spr_6:CtSprite;
var spr_5:CtSprite;
var spr_4:CtSprite;
var spr_3:CtSprite;
var spr_2:CtSprite;
var spr_1:CtSprite;

function create():Void{
	set_inCutscene(true);
	camGame.visible = false;
	
	// bg 

	spr_6 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_6.png");
	spr_6.antialiasing = false;
	spr_6.camera = camOverlay;
	add(spr_6);
	
	spr_5 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_5.png");
	spr_5.antialiasing = false;
	spr_5.camera = camOverlay;
	add(spr_5);

	spr_4 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_4.png");
	spr_4.antialiasing = false;
	spr_4.camera = camOverlay;
	add(spr_4);

	spr_3 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_3.png");
	spr_3.antialiasing = false;
	spr_3.camera = camOverlay;
	add(spr_3);

	spr_2 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_2.png");
	spr_2.antialiasing = false;
	spr_2.camera = camOverlay;
	add(spr_2);

	spr_1 = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "prologue_1.png");
	spr_1.antialiasing = false;
	spr_1.camera = camOverlay;
	add(spr_1);

	for(spr in [spr_1, spr_2, spr_3, spr_4, spr_5, spr_6]){
		spr.y = FlxG.height - spr.height;
	}

	camOverlay.scroll.y = spr_1.y;

	// ui

	bottom = new CtSprite().createFromImage(Constants.chapterIntroGraphicPath + "bottom.png");
	bottom.screenCenter();
	bottom.y = FlxG.height - bottom.height;
	bottom.antialiasing = false;
	bottom.camera = camUI;
	add(bottom);

	letters = new FlxSpriteGroup();
	letters.camera = camUI;
	add(letters);

	// black
	black = new CtSprite().createColorBlock(FlxG.width, FlxG.height, 0xFF000000);
	black.camera = camUI;
	add(black);

	CtSound.play(Constants.sfxPath + "getofftrain.ogg");

	new FlxTimer().start(9, function(f):Void{
		doMusicScene();
	});
}

function update(elapsed:Float):Void{
	if(conductor != null){
		conductor.update(elapsed);
	}
}

function doMusicScene():Void{
	FlxTween.tween(black, {alpha: 0}, 6);

	FlxTween.tween(camOverlay.scroll, {y: -100}, 10);

	conductor = new CtConductor(175, CtSound.play(Constants.musicPath + "chapterintro_0.ogg"));
	conductor.start();

	conductor.onBeat.add(function(beat:Int):Void{
		if(beat >= startingBeat && beat < endingBeat){
			addNewLetter();
			if(text.length == 0 && !ending){
				ending = true;

				new FlxTimer().start(1, function(f):Void{
					addBigText();

					new FlxTimer().start(4, function(f):Void{
						moveRoom("factory_outside", 3);
					});
				});
			}
		}
	});
}

function addNewLetter():Void{
	if(text.length <= 0) return; // dont do that

	var letter = text[0];
	text.shift();

	var newLetter = new CtText();
	newLetter.text = letter;
	newLetter.setFormat(Constants.fontName, 70);
	letters.add(newLetter);

	var thex = 50;

	if(letterList.length > 0){
		thex = letterList[letterList.length - 1].x + letterList[letterList.length - 1].width + 5;
	}

	newLetter.setPosition(thex, FlxG.height - newLetter.height - 50);

	letterList.push(newLetter);

	doLetterTransition(newLetter, 1);
}

function addBigText():Void{
	var lastLetter = letterList[letterList.length - 1];
	var x = lastLetter.x + lastLetter.width;

	var trueLength = FlxG.width - x;

	var bigText = new CtText();
	bigText.text = '"' + chapterName + '"';
	bigText.setFormat(Constants.fontName, 60, 0xFF0000FF);
	letters.add(bigText);

	bigText.setPosition(x + trueLength / 2 - bigText.width / 2, FlxG.height - bigText.height - 50);

	doLetterTransition(bigText, 2.2);
}

function doLetterTransition(text:FlxSprite, time:Float):Void{
	text.y -= 30;
	text.alpha = 0;
	FlxTween.tween(text, {alpha: 1, y: text.y + 30}, time, {ease: FlxEase.quartOut});
}